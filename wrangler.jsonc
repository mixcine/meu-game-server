{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meu-game-server",
  "main": "worker.js",
  "compatibility_date": "2025-09-27",
  "durable_objects": {
    "bindings": [
      {
        "name": "LOBBY_MANAGER",
        "class_name": "LobbyManager"
      },
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "LobbyManager",
        "GameRoom"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  },
  "vars": {
    "ACTIVE_TURN_INDEX": "0",
    "METERED_ACCOUNTS_URL": "https://pastefy.app/fKPMN7uS/raw",
    "PASTEFY_PASTE_ID": "fKPMN7uS",
    "METERED_CACHE_SECONDS": "300",
    "TURN_QUOTA_MB": "480",
    "TURN_RESET_DAYS": "30"
  }
}
