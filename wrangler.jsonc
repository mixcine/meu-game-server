{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "meu-game-server",

  "main": "worker.js",

  "compatibility_date": "2026-09-03",

  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },

  "exports": {
    "GameRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
